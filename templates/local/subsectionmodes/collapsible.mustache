{{!
    @template format_onetopic/local/subsectionmodes/collapsible

    List template for subsection mode.

    Example context (json):
    {
        "num": 3,
        "id": 35,
        "sectionname": "Subsection 3",
        "sectionreturnnum": 1,
        "header": true,
        "contentcollapsed": false,
        "resourcelayout": "cards",
        "hasavailability": true,
        "summary": true,
        "availability": true,
        "cmsummary": true,
        "cmlisthtml": "<ul class=\"section m-0 p-0\"><li class=\"activity\">Activity item</li></ul>",
        "cmcontrols": "",
        "onlysummary": false,
        "ishidden": false,
        "iscurrent": false,
        "displayonesection": false,
        "isstealth": false,
        "appearancecode": "my_custom_appearance"
    }
}}
{{< format_onetopic/local/content/delegatedsection }}
    {{$ core_courseformat/local/content/section/content }}
        <div class="course-section-header d-flex"
            data-for="section_title"
            data-id="{{id}}"
            data-number="{{num}}"
        >
           {{#header}}
                {{$ core_courseformat/local/content/section/header }}
                    {{> core_courseformat/local/content/section/header }}
                {{/ core_courseformat/local/content/section/header }}
            {{/header}}
        </div>
        <div id="coursecontentcollapseid{{id}}"
            class="content course-content-item-content collapse {{^contentcollapsed}}show{{/contentcollapsed}} {{#resourcelayout}}resourcelayout_{{.}}{{/resourcelayout}}">
            <div class="{{#hasavailability}}description{{/hasavailability}} my-3" data-for="sectioninfo">
                {{#isstealth}}
                <div class="alert alert-warning">
                    {{#str}} orphansectionwarning, core_courseformat {{/str}}
                </div>
                {{/isstealth}}
                {{#summary}}
                    {{$ core_courseformat/local/content/section/summary }}
                        {{> core_courseformat/local/content/section/summary }}
                    {{/ core_courseformat/local/content/section/summary }}
                {{/summary}}
                {{#availability}}
                    {{$ core_courseformat/local/content/section/availability }}
                        {{> core_courseformat/local/content/section/availability }}
                    {{/ core_courseformat/local/content/section/availability }}
                {{/availability}}
            </div>
            {{#cmsummary}}
                {{$ core_courseformat/local/content/section/cmsummary }}
                    {{> core_courseformat/local/content/section/cmsummary }}
                {{/ core_courseformat/local/content/section/cmsummary }}
            {{/cmsummary}}
            {{{cmlisthtml}}}
            {{{cmcontrols}}}
        </div>
    {{/ core_courseformat/local/content/section/content }}
{{/ format_onetopic/local/content/delegatedsection}}
