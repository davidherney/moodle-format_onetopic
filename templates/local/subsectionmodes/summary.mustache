{{!
    @template format_onetopic/local/subsectionmodes/summary

    Summary card for a delegated section. The content block is local so the card stays expanded
    and keeps the go-to-section link without using the core section content template.

    Example context (json):
    {
    }
}}
{{< core_courseformat/local/content/delegatedsection }}
    {{$ core_courseformat/local/content/section/content }}
        <div class="course-section-header d-flex"
            data-for="section_title"
            data-id="{{id}}"
            data-number="{{num}}"
        >
            {{#singleheader}}
                <h3 id="sectionid-{{id}}-title" class="h4 sectionname">
                    {{{title}}}
                </h3>
            {{/singleheader}}
            {{#header}}
                <h3 id="sectionid-{{id}}-title" class="h4 sectionname">
                    {{{title}}}
                </h3>
            {{/header}}
            {{^singleheader}}
                {{#restrictionlock}}
                    <div class="align-self-center ms-2">
                        {{#pix}}t/unlock, core{{/pix}}
                    </div>
                {{/restrictionlock}}
            {{/singleheader}}
            <div data-region="sectionbadges" class="sectionbadges d-flex align-items-center">
                {{$ core_courseformat/local/content/section/badges }}
                    {{> core_courseformat/local/content/section/badges }}
                {{/ core_courseformat/local/content/section/badges }}
            </div>
            {{^onlysummary}}
                {{#controlmenu}}
                    {{$ core_courseformat/local/content/section/controlmenu }}
                        {{> core_courseformat/local/content/section/controlmenu }}
                    {{/ core_courseformat/local/content/section/controlmenu }}
                {{/controlmenu}}
            {{/onlysummary}}
            {{#onlysummary}}
                {{#header}}
                    {{#url}}
                        <div class="section_goto bulk-hidden ms-auto" data-sectionid="{{id}}">
                            <a href="{{{url}}}"
                               class="btn btn-icon d-flex"
                               title="{{#str}}gotosection, course, {{name}}{{/str}}">
                                <span class="dir-rtl-hide">
                                    {{#pix}}t/right, moodle{{/pix}}
                                </span>
                                <span class="dir-ltr-hide">
                                    {{#pix}}t/left, moodle, {{#str}}gotosection, course, {{name}}{{/str}}{{/pix}}
                                </span>
                                <span class="visually-hidden">
                                    {{#str}}gotosection, course, {{name}}{{/str}}
                                </span>
                            </a>
                        </div>
                    {{/url}}
                {{/header}}
            {{/onlysummary}}
        </div>
        <div id="coursecontentcollapseid{{id}}" class="content">
            <div class="{{#hasavailability}}description{{/hasavailability}} my-3" data-for="sectioninfo">
                {{#isstealth}}
                <div class="alert alert-warning">
                    {{#str}} orphansectionwarning, core_courseformat {{/str}}
                </div>
                {{/isstealth}}
                {{#summary}}
                    {{$ core_courseformat/local/content/section/summary }}
                        {{> core_courseformat/local/content/section/summary }}
                    {{/ core_courseformat/local/content/section/summary }}
                {{/summary}}
                {{#availability}}
                    {{$ core_courseformat/local/content/section/availability }}
                        {{> core_courseformat/local/content/section/availability }}
                    {{/ core_courseformat/local/content/section/availability }}
                {{/availability}}
            </div>
            {{#cmsummary}}
                {{$ core_courseformat/local/content/section/cmsummary }}
                    {{> core_courseformat/local/content/section/cmsummary }}
                {{/ core_courseformat/local/content/section/cmsummary }}
            {{/cmsummary}}
            {{#cmlist}}
                {{$ core_courseformat/local/content/section/cmlist }}
                    {{> core_courseformat/local/content/section/cmlist }}
                {{/ core_courseformat/local/content/section/cmlist }}
            {{/cmlist}}
            {{{cmcontrols}}}
        </div>
    {{/ core_courseformat/local/content/section/content }}
{{/ core_courseformat/local/content/delegatedsection}}
