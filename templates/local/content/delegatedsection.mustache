{{!
    @template format_onetopic/local/content/delegatedsection

    Onetopic wrapper for delegated sections (subsections).
    Adds the appearance uniquecode as a CSS class to the section element.

    Example context (json):
    {
        "num": 3,
        "id": 35,
        "appearancecode": "my_custom_appearance"
    }
}}
<ul class="p-0">
    <li id="section-{{num}}"
        class="section course-section main {{#onlysummary}} section-summary {{/onlysummary}} clearfix
                {{#ishidden}} hidden {{/ishidden}} {{#iscurrent}}{{^displayonesection}} current {{/displayonesection}}{{/iscurrent}}
                {{#isstealth}} orphaned {{/isstealth}} delegated-section {{#appearancecode}}appearance-customized appearance-{{.}}{{/appearancecode}}"
        data-sectionid="{{num}}"
        data-sectionreturnnum="{{sectionreturnnum}}"
        data-for="section"
        data-id="{{id}}"
        data-number="{{num}}"
        data-sectionname="{{sectionname}}"
    >
        <div class="section-item">
            {{$ core_courseformat/local/content/section/content }}
                {{> core_courseformat/local/content/section/content }}
            {{/ core_courseformat/local/content/section/content }}
        </div>
    </li>
</ul>
