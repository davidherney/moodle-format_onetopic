{{!
    @template format_onetopic/appearance_usages

    Template to display appearance usages in a modal.

    Context variables required for this template:
    * hasusages - boolean - Whether there are usages
    * usages - array - List of usages
    * usages.name - string - The usage description
    * usages.url - string - The URL to the usage location

    Example context (json):
    {
        "hasusages": true,
        "usages": [
            {"name": "Default appearance", "url": "/admin/settings.php?section=formatsettingonetopic"},
            {"name": "My Course: Custom appearance", "url": "/course/edit.php?id=2"}
        ]
    }
}}
{{#hasusages}}
<ul class="list-group">
    {{#usages}}
    <li class="list-group-item">
        <a href="{{url}}" target="_blank">{{name}}</a>
    </li>
    {{/usages}}
</ul>
{{/hasusages}}
{{^hasusages}}
<div class="alert alert-info">
    {{#str}}nousagesfound, format_onetopic{{/str}}
</div>
{{/hasusages}}
