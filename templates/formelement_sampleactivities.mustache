{{!
    @template format_onetopic/formelement_sampleactivities

    Partial template for rendering sample activity items in style previews.

    Context variables required for this template:
    * sampleactivities - array of activity objects with modname, iconclass, icon, label

    Example context (json):
    {
        "sampleactivities": [
            { "modname": "forum", "iconclass": "collaboration", "icon": "<i class=\"icon\"></i>", "label": "Discussion forum" },
            { "modname": "page", "iconclass": "content", "icon": "<i class=\"icon\"></i>", "label": "Content page" },
            { "modname": "quiz", "iconclass": "assessment", "icon": "<i class=\"icon\"></i>", "label": "Assessment quiz" }
        ]
    }
}}
<ul class="section m-0 p-0 img-text d-block">
    {{#sampleactivities}}
    <li class="activity activity-wrapper {{modname}} modtype_{{modname}}" style="list-style:none;">
        <div class="activity-item">
            <div class="activity-grid">
                <div class="activity-icon activityiconcontainer smaller {{iconclass}} courseicon align-self-start me-2">
                    {{{icon}}}
                </div>
                <div class="activity-name-area activity-instance d-flex flex-column me-2">
                    <div class="activitytitle modtype_{{modname}} position-relative align-self-start">
                        <div class="activityname">
                            <a class="aalink" href="#" onclick="return false;"><span class="instancename">{{label}}</span></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </li>
    {{/sampleactivities}}
</ul>
