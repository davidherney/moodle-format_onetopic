{{!
    @template format_onetopic/formelement_subsectionstyles

    Form element template for subsection styles.

    Context variables required for this template:
    * name - form element name
    * id - element id
    * value - element value

    Example context (json):
    {
        "name": "configdata",
        "id": "configdata0",
        "value": "",
        "cssunits": [
            { "value": "px", "label": "px" }
        ],
        "csssizeoptions": [ "8", "10", "12" ],
        "colorpicker": ""
    }
}}
<div id="onetopic-subsectionstyles" class="form-text defaultsnext format-onetopic">
    <div id="subsection-tree-start">
    {{!
        Input to save the configured styles.
    }}
        <textarea name="{{name}}" id="{{id}}" class="savecontrol hidden">{{value}}</textarea>

        <div class="subsectionstyleset-buttons">
            <button id="subsectionstylesetdefault" class="btn btn-secondary">{{#str}} subsectionstylesetdefault, format_onetopic {{/str}}</button>
            <button id="subsectionstyleclear" class="btn btn-warning">{{#str}} tabstyleclear, format_onetopic {{/str}}</button>
        </div>
        <p>{{#str}} subsectionstylebuttons_help, format_onetopic {{/str}}</p>

        <div class="subsection-styles-preview p-3 border rounded">
            <div class="subsection-preview-container">
                <div class="d-flex align-items-center mb-2">
                    <span class="mr-2">📁</span>
                    <strong>{{#str}} samplesubsection, format_onetopic {{/str}}</strong>
                </div>
                <div class="ml-4">
                    <div class="activity-item d-flex align-items-center p-2 mb-1 border rounded">
                        <span class="mr-2">📄</span>
                        <span>{{#str}} sampleresource, format_onetopic {{/str}}</span>
                    </div>
                    <div class="activity-item d-flex align-items-center p-2 mb-1 border rounded">
                        <span class="mr-2">📝</span>
                        <span>{{#str}} sampleactivity, format_onetopic {{/str}}</span>
                    </div>
                    <div class="activity-item d-flex align-items-center p-2 mb-1 border rounded">
                        <span class="mr-2">📄</span>
                        <span>{{#str}} sampleresource, format_onetopic {{/str}} 2</span>
                    </div>
                </div>
            </div>
        </div>

        {{> format_onetopic/formelement_stylesmodal}}
    </div>
</div>
